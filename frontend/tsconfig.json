{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",   // MUST be es2020+ for import.meta
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/stores/BookData.js"],
  "exclude": ["node_modules", "dist"]
}
